{
  "port": 4300,
  "dependsOn": [],
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "dev": {
    "command": "bun run dev",
    "watch": [
      "src/**/*"
    ]
  },
  "healthCheckPath": "/health",
  "$schema": "https://tdk-landscape.github.io/schema.service.json",
  "schemaVersion": 1,
  "appName": "vercel-bff",
  "appType": "backend",
  "featuresEnabled": [],
  "name": "vercel-bff",
  "type": "backend",
  "stack": "store",
  "framework": "hono",
  "params": {
    "VERCEL_STORE_ORIGIN": "https://vercel.store",
    "STORE_FRONTEND_ORIGIN": "http://app.vercel-store.localhost:8080",
    "STORE_BFF_ORIGIN": "http://api.vercel-store.localhost:8080"
  },
  "healthCheck": {
    "enabled": true,
    "path": "/health"
  }
}