# Copy to .env. No credentials needed: the catalog is synced from the public vercel.store storefront.
VERCEL_STORE_ORIGIN=https://vercel.store
# Match your Traefik public origins (include a non-default host port).
STORE_FRONTEND_ORIGIN=http://app.vercel-store.localhost:8080
STORE_BFF_ORIGIN=http://api.vercel-store.localhost:8080
# Optional browser-safe BFF URL override.
VITE_STORE_BFF_URL=
TDK_HTTP_PORT=8080
TDK_HTTPS_PORT=8443
